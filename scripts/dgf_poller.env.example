# DGF / api.minenergia.cl poller (Trello card #56) — see scripts/dgf_poller.py
# Copy these lines into your gitignored .env and fill in the blanks.

DGF_BASE_URL=https://api.minenergia.cl
DGF_USERNAME=your-registered-email@example.com
DGF_PASSWORD=

# Comma-separated /api/ paths to poll. Unknown until first login (account pending
# approval) — browse /api/ once you're in, then list the data endpoints here.
DGF_ENDPOINTS=

# Where landed files go. Local dir for testing; on Databricks point at a UC Volume
# so the existing Auto Loader bronze ingests them:
#   DGF_LANDING=/Volumes/<catalog>/<bronze_schema>/lookup/dgf/
DGF_LANDING=./_dgf_landing
